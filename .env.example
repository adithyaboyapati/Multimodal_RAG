# =====================================================================
# NovaCore Multimodal RAG - Environment Variables Template
# Copy this file to .env and fill in your actual API keys.
# =====================================================================

# ---------------------------------------------------------------------
# Required API Keys
# ---------------------------------------------------------------------
# Groq API Key: Used for Text LLM (ChatGroq) and Vision LLM (summarizing visuals & multimodal Q&A)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Pinecone API Key: Used for Pinecone vector database index creation, upsert, and similarity search
# Get your key at: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here

# OpenAI API Key: Used for text-embedding-3-small embeddings
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# NVIDIA API Key: Used for NeMo Retriever NIM reranking API
# Get your key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# ---------------------------------------------------------------------
# Optional Pinecone Configuration
# ---------------------------------------------------------------------
PINECONE_INDEX_NAME=novacore-multimodal-rag
PINECONE_NAMESPACE=fy2026-demo
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------------------------------------------------------------------
# Model & Provider Configuration
# ---------------------------------------------------------------------
TEXT_MODEL=openai/gpt-oss-20b
VISION_MODEL=qwen/qwen3.8-27b

# Dense Embeddings: 'openai' (text-embedding-3-small) or 'sentence-transformers'
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# Reranker: 'nvidia' (NVIDIA NIM Cloud API) or 'local' (Cross-Encoder)
RERANKER_PROVIDER=nvidia
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
